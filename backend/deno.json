{
  "imports": {
    "@oak/oak": "jsr:@oak/oak@^17.0.0",
    "@oak/oak/router": "jsr:@oak/oak@^17.0.0/router",
    "@oak/cors": "jsr:@oak/cors@^1.0.0",
    "@db/sqlite": "jsr:@db/sqlite@^0.13.0",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.30.0",
    "zod": "npm:zod@^3.25.0",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.20/bdd",
    "@std/assert": "jsr:@std/assert@^1.0.19",
