# Copy to .env and adjust. docker compose reads .env from the project root.

# Secret used to sign JWTs. When empty (or the variable is unset) the container
# generates one on first start and persists it under the data volume, so it is
# stable across restarts. Set it explicitly for production deployments.
JWT_SECRET=

# Comma-separated list of browser origins allowed by CORS. Default when
# unset: http://localhost:8124.
# CORS_ORIGINS=http://localhost:8124,http://192.168.1.50:8124
