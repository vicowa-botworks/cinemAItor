{
  "tasks": {
    "setup": "deno install && cd backend && deno install && cd ../frontend && deno install",
    "dev:backend": "cd backend && deno run --watch --env-file=.env --allow-net --allow-env --allow-read --allow-write --allow-ffi --allow-run src/server.ts",
    "dev:frontend": "cd frontend && deno run --allow-net --allow-env --allow-read src/server.js",
    "dev": "deno run -A dev.ts",
    "test:backend": "cd backend && deno test --allow-net --allow-env --allow-read --allow-write --allow-ffi --allow-run",
    "test:frontend": "cd frontend && deno test --allow-net --allow-env",
    "test": "deno task test:backend && deno task test:frontend",
    "lint": "deno task lint:backend && deno task lint:frontend",
    "lint:backend": "cd backend && deno lint",
    "lint:frontend": "cd frontend && deno run -A npm:eslint@^9.33.0 .",
    "check": "deno task check:backend && deno task check:frontend",
    "check:backend": "cd backend && deno check src tests",
    "check:frontend": "cd frontend && deno check src tests",
    "fmt": "deno fmt",
    "start": "cd backend && deno run --env-file=.env --allow-net --allow-env --allow-read --allow-write --allow-ffi --allow-run src/server.ts"
  },
  "imports": {
    "@std/path": "jsr:@std/path@1"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "exclude": ["e2e"]
  },
  "linter": {
    "enabled": false
  }
}
