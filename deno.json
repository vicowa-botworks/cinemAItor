{
  "tasks": {
    "setup": "deno install && cd backend && deno install && cd ../frontend && deno install",
    "dev:backend": "cd backend && deno run --watch --allow-net --allow-env --allow-read --allow-write --allow-ffi src/server.ts",
    "dev:frontend": "cd frontend && deno run --allow-net --allow-env src/server.ts",
    "dev": "deno run -A dev.ts",
    "test:backend": "cd backend && deno test --allow-net --allow-env --allow-read --allow-write --allow-ffi",
    "test:frontend": "cd frontend && deno test --allow-net --allow-env",
    "test": "deno task test:backend && deno task test:frontend",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "start": "cd backend && deno run --allow-net --allow-env --allow-read --allow-write --allow-ffi src/server.ts"
  },
  "imports": {
    "@std/path": "jsr:@std/path@1"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "linter": {
    "enabled": false
  }
}
